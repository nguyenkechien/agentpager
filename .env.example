# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user ids allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=

# Absolute path to the Claude Code CLI on this machine
CLAUDE_EXECUTABLE=C:\Users\chien\.local\bin\claude.exe

# Folder whose subfolders are offered by /project
PROJECTS_ROOT=D:\Projects

# Minutes without activity before a session ends
IDLE_TIMEOUT_MINUTES=60

# Optional: opus | sonnet | haiku (empty = Claude Code default)
DEFAULT_MODEL=

# Optional: low | medium | high | xhigh | max (empty = Claude Code default)
DEFAULT_EFFORT=

# State, uploads and lock file (relative paths resolve against the project folder)
DATA_DIR=./data

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
