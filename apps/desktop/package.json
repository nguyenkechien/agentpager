{
  "name": "@agentpager/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "agentpager desktop app",
  "license": "MIT",
  "author": "nguyenkechien",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "tsx scripts/ensureReleaseFree.ts && electron-vite build && electron-builder --dir",
    "dist": "tsx scripts/ensureReleaseFree.ts && electron-vite build && electron-builder --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/renderer/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke": "playwright test",
    "icons": "tsx scripts/renderIcons.ts"
  },
  "dependencies": {
    "@chiennguyen/agentpager": "0.1.3",
    "electron-updater": "6.8.9",
    "grammy": "1.46.0",
    "semver": "7.7.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/js-yaml": "4.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "js-yaml": "4.3.2",
    "jsdom": "30.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "7.3.6"
  }
}
